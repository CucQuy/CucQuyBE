# ── DB / cache ──
DATABASE_URL=postgresql://cucquy:<pw>@localhost:5432/cucquy
REDIS_URL=redis://localhost:6379

# ── MQTT (broker Mosquitto — publish order:paid cho thiết bị POS/ESP32). Trống = tắt. ──
# Prod (trong cluster): mqtt://<user>:<pass>@mosquitto.mqtt.svc.cluster.local:1883
MQTT_URL=

# ── Server ──
PORT=3000
# Nhãn môi trường: production | staging | local. Gắn vào noti Zalo ([STAGING]/[LOCAL])
# để biết tin bắn từ đâu; production để trống tag. (production/staging set ở k8s secret)
APP_ENV=local
# Danh sách origin FE được phép gọi (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=https://admin.cucquy.site,https://cucquy.site

# ── Auth SSO (RiceService phát JWT; secret PHẢI trùng rice-backend-env) ──
SSO_JWT_SECRET=

# ── Object storage (RiceService self-hosted) ──
RICE_ENDPOINT=https://api.riceservice.xyz
RICE_BUCKET=
RICE_API_KEY=

# ── Tích hợp ngoài (secret — đã chuyển từ FE về BE) ──
SERPAPI_KEY=
VISION_API_KEY=
GEMINI_API_KEY=
ZALO_URL=https://new.abitstore.vn
ZALO_SHOP_CODE=
ZALO_TOKEN=
ZALO_MAIN_GROUP_ID=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
