# ── DB / cache ──
DATABASE_URL=postgresql://cucquy:<pw>@localhost:5432/cucquy
REDIS_URL=redis://localhost:6379

# ── MQTT (broker Mosquitto — publish order:paid cho thiết bị POS/ESP32). Trống = tắt. ──
# Prod (trong cluster): mqtt://<user>:<pass>@mosquitto.mqtt.svc.cluster.local:1883
MQTT_URL=
# Device id thiết bị POS → topic cucquy/<id>/order/{create,paid} (khớp firmware ESP32).
POS_DEVICE_ID=esp_01

# ── Server ──
PORT=3000
# Nhãn môi trường: production | staging | local. Gắn vào noti Zalo ([STAGING]/[LOCAL])
# để biết tin bắn từ đâu; production để trống tag. (production/staging set ở k8s secret)
APP_ENV=local
# Danh sách origin FE được phép gọi (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=https://admin.cucquy.site,https://cucquy.site

# ── Auth SSO (RiceService phát JWT; secret PHẢI trùng rice-backend-env) ──
SSO_JWT_SECRET=

# ── Bảng lương: link tải Excel gửi Zalo (file KHÔNG lưu, sinh khi bấm) ──
# PUBLIC_API_URL: base API công khai để dựng link (mặc định https://api.cucquy.site/api).
# PAYROLL_LINK_SECRET: secret ký token link (bỏ trống → fallback SSO_JWT_SECRET).
PUBLIC_API_URL=
PAYROLL_LINK_SECRET=

# ── Object storage (RiceService self-hosted) ──
RICE_ENDPOINT=https://api.riceservice.xyz
RICE_BUCKET=
RICE_API_KEY=

# ── Tích hợp ngoài (secret — đã chuyển từ FE về BE) ──
SERPAPI_KEY=
VISION_API_KEY=
GEMINI_API_KEY=
ZALO_URL=https://new.abitstore.vn
ZALO_SHOP_CODE=
ZALO_TOKEN=
ZALO_MAIN_GROUP_ID=
# SĐT tài khoản Zalo dùng để gửi (dạng 84xxxxxxxxx). Trống → mặc định trong code.
ZALO_SENDER_NUMBER=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=

# ── Facebook Messenger (fanpage) ──
# Webhook: https://api.cucquy.site/api/webhooks/facebook (khai ở developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_VERIFY_TOKEN=
